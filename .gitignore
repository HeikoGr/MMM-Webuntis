# Logs
logs/
*.log
npm-debug.log*

# Dependencies
node_modules/

# Local MagicMirror overrides (generate these from the *.template files in config/)
config/.env
config/config.js
config/custom.css

# MagicMirror module checker (node --run check)
.mm-module-checker/
magicmirror-check-results.md

# Playwright MCP default output dir (the devcontainer config writes to /tmp instead)
.playwright-mcp/

# Raw payload dumps (dumpBackendPayloads / dumpRawApiResponses)
debug_dumps/

# Local git-hook helper scripts (generated by some hook tools)
i/

# Local scratch files - the tracked plan lives in docs/plan.md
/plan.md
.github/agents/modernizations.agent.md
