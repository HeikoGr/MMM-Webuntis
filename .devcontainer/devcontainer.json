{
  "name": "MMM-Webuntis (MagicMirror Dev)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/opt/magic_mirror/modules/MMM-Webuntis",
  "workspaceMount": "source=${localWorkspaceFolder},target=/opt/magic_mirror/modules/MMM-Webuntis,type=bind",
  "overrideCommand": false,
  "runArgs": ["--shm-size=1g"],
  "shutdownAction": "stopContainer",
  "remoteUser": "root",
  "containerEnv": {
    "IN_DEVCONTAINER": "1",
    "PLAYWRIGHT_CHROMIUM_ARGS": "--no-sandbox --disable-dev-shm-usage --disable-gpu"
  },
  "forwardPorts": [8080],
  // The host's Claude Code login and SSH keys are mounted read-only so the container
  // can inherit them. Runtime bind mounts: nothing lands in the image, and all that is
  // committed here are two paths. Read-only on purpose - the container runs as root,
  // so a writable mount would leave root-owned files in the host's home directory.
  // .devcontainer/postStart.sh copies both into the container's own HOME.
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/tmp/host-claude,type=bind,readonly",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/tmp/host-ssh,type=bind,readonly"
  ],

  "customizations": {
    "vscode": {
      // All shared extensions come from the base image (devcontainer.metadata label in
      // MMM-DevContainer/docker/Dockerfile) and are merged in automatically.
      "extensions": [],
      "settings": {
        "chat.mcp.autoStart": true,
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        // Guided commit form matching commitlint.config.js. The scope list is optional;
        // leaving it empty is fine for repo-wide changes.
        "conventionalCommits.showEditor": true,
        "conventionalCommits.promptScopes": true,
        "conventionalCommits.promptBody": true,
        "conventionalCommits.promptFooter": true,
        "conventionalCommits.scopes": [
          "grid",
          "lessons",
          "exams",
          "homework",
          "absences",
          "messagesofday",
          "auth",
          "api",
          "config",
          "plugins",
          "cli",
          "deps"
        ]
      }
    }
  },
  "postCreateCommand": "/bin/sh .devcontainer/postCreate.sh",
  "postStartCommand": "/bin/sh .devcontainer/postStart.sh"
}
