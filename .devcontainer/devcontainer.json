{
  "name": "MMM-Webuntis (MagicMirror Dev)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/opt/magic_mirror/modules/MMM-Webuntis",
  "workspaceMount": "source=${localWorkspaceFolder},target=/opt/magic_mirror/modules/MMM-Webuntis,type=bind",
  "overrideCommand": false,
  "runArgs": ["--shm-size=1g"],
  "shutdownAction": "stopContainer",
  "remoteUser": "root",
  "containerEnv": {
    "IN_DEVCONTAINER": "1",
    "PLAYWRIGHT_CHROMIUM_ARGS": "--no-sandbox --disable-dev-shm-usage --disable-gpu",
    "ENABLE_PLAYWRIGHT_MCP": "1"
  },
  "forwardPorts": [8080],
  "customizations": {
    "vscode": {
      "extensions": ["actboy168.tasks", "vstirbu.vscode-mermaid-preview", "vivaxy.vscode-conventional-commits"],
      "settings": {
        "chat.mcp.autoStart": true,
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        // Guided commit form matching commitlint.config.js. The scope list is optional;
        // leaving it empty is fine for repo-wide changes.
        "conventionalCommits.showEditor": true,
        "conventionalCommits.promptScopes": true,
        "conventionalCommits.promptBody": true,
        "conventionalCommits.promptFooter": true,
        "conventionalCommits.scopes": [
          "grid",
          "lessons",
          "exams",
          "homework",
          "absences",
          "messagesofday",
          "auth",
          "api",
          "config",
          "plugins",
          "cli",
          "deps"
        ]
      }
    }
  },
  "postCreateCommand": "/bin/sh .devcontainer/postCreate.sh",
  "postStartCommand": "mkdir -p /tmp/playwright-mcp-output && if [ \"${ENABLE_PLAYWRIGHT_MCP:-1}\" = \"1\" ]; then nohup playwright-mcp --headless --isolated --no-sandbox --port=8931 --output-dir=/tmp/playwright-mcp-output > /tmp/playwright-mcp.log 2>&1 & echo \"Playwright MCP started (logs: /tmp/playwright-mcp.log, port: 8931)\"; else echo 'Playwright MCP disabled via ENABLE_PLAYWRIGHT_MCP'; fi; echo 'Devcontainer started. MagicMirror at http://localhost:8080'; echo 'Playwright MCP is configured in .vscode/mcp.json'"
}
