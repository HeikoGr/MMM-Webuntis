{
  "recommendations": [
    // Manages the devcontainer defined in .devcontainer/. This one deliberately stays a workspace
    // recommendation instead of being baked into the base image: it has to run on the host to open
    // the container in the first place, so it can never arrive from inside it. Everything that
    // belongs *inside* the container comes from the devcontainer.metadata label in
    // MMM-DevContainer/docker/Dockerfile.
    "ms-azuretools.vscode-containers"
  ]
}
