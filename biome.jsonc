// Shared Biome configuration of the MagicMirror modules (mmm-shared, MMM-CalDAV-Tasks,
// MMM-HomeConnect2, MMM-LibraryMonitor, MMM-Photoprism2, MMM-Webuntis). Keep it identical across the repos;
// only defaultBranch, the asset ignores and module-specific globals differ.
{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "master"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.mm-module-checker",
      "!lib/mmm-shared",
      "!**/*.md",
      "!**/*.png",
      "!debug_dumps"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf",
    "useEditorconfig": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noArguments": "error",
        "noImportantStyles": "warn",
        "useDateNow": "warn",
        "useOptionalChain": "warn"
      },
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUnusedFunctionParameters": "warn",
        "noUnusedVariables": "error"
      },
      "style": {
        "noDescendingSpecificity": "warn",
        "useNodejsImportProtocol": "error",
        "useConst": "error",
        "useTemplate": "warn"
      },
      "suspicious": {
        "noAssignInExpressions": "error",
        "noDuplicateProperties": "error",
        "noConsole": "off",
        "noGlobalIsFinite": "error",
        "noGlobalIsNan": "error",
        "useIterableCallbackReturn": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSameLine": false
    },
    "globals": ["Log", "Module", "config"]
  }
}
