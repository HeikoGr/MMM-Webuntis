{
  "name": "mmm-webuntis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeikoGr/MMM-Webuntis"
  },
  "version": "0.9.0",
  "description": "MagicMirror module to access Webuntis school timetables.",
  "main": "MMM-Webuntis.js",
  "exports": {
    ".": "./MMM-Webuntis.js",
    "./node_helper": "./node_helper.js",
    "./package.json": "./package.json"
  },
  "files": [
    "MMM-Webuntis.css",
    "node_helper.js",
    "lib/",
    "plugins/",
    "config/",
    "translations/"
  ],
  "sideEffects": true,
  "keywords": [
    "MagicMirror",
    "webuntis",
    "school",
    "timetable"
  ],
  "author": "HeikoGr",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.js",
    "postinstall": "node scripts/install-mmm-shared-submodule.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test tests/*.test.js",
    "test:auth:curl": "bash scripts/test_auth_with_curl.sh --from-config",
    "test:api": "node scripts/test_api_endpoint.js",
    "test:api:discover": "bash scripts/discover_endpoints.sh",
    "diagnose": "bash scripts/diagnose_instability.sh",
    "debug": "node scripts/node_helper_wrapper.js",
    "check": "node --run mmcheck",
    "mmcheck": "node scripts/magicmirror-check.mjs --devcontainer-only --current",
    "deps:update": "npx --yes npm-check-updates -u && npm install && npx @biomejs/biome migrate --write",
    "shared:update": "git submodule update --remote --init --checkout lib/mmm-shared && git submodule status lib/mmm-shared"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --files-ignore-unknown=true"
    ]
  },
  "dependencies": {
    "otplib": "^13.4.1",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "lint-staged": "^17.3.0",
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged",
    "commit-msg": "npx --no-install commitlint --edit $1 && node scripts/check-commit-scope.js $1"
  },
  "allowScripts": {
    "simple-git-hooks@2.13.1": true
  }
}
